#!/usr/bin/env bash
# agency-generated: v1 — capability_novel_set_reveal_rule
# Mint/update a ``RevealRule`` — upsert keyed by (novel, fact, tier) (effect).
# Usage: agency-novel-set_reveal_rule [--intent-id ID] <novel_id> <fact> <tier> <may_know_from_chapter> [must_not_before] [channel] [rationale] [fact_node_id]
set -euo pipefail

iid="${AGENCY_INTENT_ID:-}"
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --intent-id) iid="$2"; shift 2;;
    --) shift; args+=("$@"); break;;
    *) args+=("$1"); shift;;
  esac
done

if [ -z "$iid" ]; then
  echo "error: --intent-id or AGENCY_INTENT_ID required" >&2
  exit 1
fi

if [ "${#args[@]}" -lt 4 ]; then
  echo "error: expected at least 4 required arg(s) (novel_id fact tier may_know_from_chapter); got ${#args[@]}" >&2
  exit 2
fi

kwargs=$(python3 -c '
import json, sys
def _coerce(raw, ann):
    # PR review round 8: argv arrives as a string regardless of the
    # verb signature; coerce to the declared annotation so list/int/
    # bool params reach the verb in the right shape. JSON-first lets
    # callers pass e.g. `--axes "[\"quality\",\"security\"]"` or the
    # bare bash form `quality,security` (CSV fallback for list-typed).
    if ann is str:
        return raw
    try:
        parsed = json.loads(raw)
    except (ValueError, TypeError):
        parsed = None
    if ann is bool:
        if isinstance(parsed, bool):
            return parsed
        return raw.lower() in ("true", "1", "yes", "y")
    if ann is int:
        if isinstance(parsed, int) and not isinstance(parsed, bool):
            return parsed
        try:
            return int(raw)
        except (ValueError, TypeError):
            return raw
    if ann is float:
        if isinstance(parsed, (int, float)) and not isinstance(parsed, bool):
            return float(parsed)
        try:
            return float(raw)
        except (ValueError, TypeError):
            return raw
    if ann is list:
        if isinstance(parsed, list):
            return parsed
        # CSV fallback so `axes=quality,security` still works at the bash
        # surface (common when scripting around the wrapper).
        return [s for s in raw.split(",") if s]
    if ann is dict:
        if isinstance(parsed, dict):
            return parsed
        return {}
    return raw
_kw = {"intent_id": sys.argv[1]}
_kw["novel_id"] = _coerce(sys.argv[2], str)
_kw["fact"] = _coerce(sys.argv[3], str)
_kw["tier"] = _coerce(sys.argv[4], str)
_kw["may_know_from_chapter"] = _coerce(sys.argv[5], int)
if len(sys.argv) > 6: _kw["must_not_before"] = _coerce(sys.argv[6], int)
if len(sys.argv) > 7: _kw["channel"] = _coerce(sys.argv[7], str)
if len(sys.argv) > 8: _kw["rationale"] = _coerce(sys.argv[8], str)
if len(sys.argv) > 9: _kw["fact_node_id"] = _coerce(sys.argv[9], str)
print(json.dumps(_kw))
' "$iid" "${args[@]}") || { echo "error: failed to build kwargs JSON" >&2; exit 3; }

exec python -m agency.cli execute --code "
import json
return await call_tool('capability_novel_set_reveal_rule', json.loads(r'''${kwargs}'''))
"
