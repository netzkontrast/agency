#!/usr/bin/env bash
# agency-generated: v1 — capability_novel_propose_canon
# Open a CanonProposal — the reviewed path toward a Lock (effect).
# Usage: agency-novel-propose_canon [--intent-id ID] <novel_id> <scope> <payload> <rationale> [tier] [evidence] [proposed_by] [author_override] [supersedes_lock]
set -euo pipefail

iid="${AGENCY_INTENT_ID:-}"
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --intent-id) iid="$2"; shift 2;;
    --) shift; args+=("$@"); break;;
    *) args+=("$1"); shift;;
  esac
done

if [ -z "$iid" ]; then
  echo "error: --intent-id or AGENCY_INTENT_ID required" >&2
  exit 1
fi

if [ "${#args[@]}" -lt 4 ]; then
  echo "error: expected at least 4 required arg(s) (novel_id scope payload rationale); got ${#args[@]}" >&2
  exit 2
fi

kwargs=$(python3 -c '
import json, sys
def _coerce(raw, ann):
    # PR review round 8: argv arrives as a string regardless of the
    # verb signature; coerce to the declared annotation so list/int/
    # bool params reach the verb in the right shape. JSON-first lets
    # callers pass e.g. `--axes "[\"quality\",\"security\"]"` or the
    # bare bash form `quality,security` (CSV fallback for list-typed).
    if ann is str:
        return raw
    try:
        parsed = json.loads(raw)
    except (ValueError, TypeError):
        parsed = None
    if ann is bool:
        if isinstance(parsed, bool):
            return parsed
        return raw.lower() in ("true", "1", "yes", "y")
    if ann is int:
        if isinstance(parsed, int) and not isinstance(parsed, bool):
            return parsed
        try:
            return int(raw)
        except (ValueError, TypeError):
            return raw
    if ann is float:
        if isinstance(parsed, (int, float)) and not isinstance(parsed, bool):
            return float(parsed)
        try:
            return float(raw)
        except (ValueError, TypeError):
            return raw
    if ann is list:
        if isinstance(parsed, list):
            return parsed
        # CSV fallback so `axes=quality,security` still works at the bash
        # surface (common when scripting around the wrapper).
        return [s for s in raw.split(",") if s]
    if ann is dict:
        if isinstance(parsed, dict):
            return parsed
        return {}
    return raw
_kw = {"intent_id": sys.argv[1]}
_kw["novel_id"] = _coerce(sys.argv[2], str)
_kw["scope"] = _coerce(sys.argv[3], str)
_kw["payload"] = _coerce(sys.argv[4], dict)
_kw["rationale"] = _coerce(sys.argv[5], str)
if len(sys.argv) > 6: _kw["tier"] = _coerce(sys.argv[6], str)
if len(sys.argv) > 7: _kw["evidence"] = _coerce(sys.argv[7], str)
if len(sys.argv) > 8: _kw["proposed_by"] = _coerce(sys.argv[8], str)
if len(sys.argv) > 9: _kw["author_override"] = _coerce(sys.argv[9], bool)
if len(sys.argv) > 10: _kw["supersedes_lock"] = _coerce(sys.argv[10], str)
print(json.dumps(_kw))
' "$iid" "${args[@]}") || { echo "error: failed to build kwargs JSON" >&2; exit 3; }

exec python -m agency.cli execute --code "
import json
return await call_tool('capability_novel_propose_canon', json.loads(r'''${kwargs}'''))
"
